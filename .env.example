# ===========================================================================
# AI Fabric & Retail SaaS - environment template
# Copy to .env for local use. NEVER commit .env.
# In production, these values are injected from AWS Secrets Manager.
# ===========================================================================
PROJECT_NAME="AI Fabric & Retail SaaS Ecosystem"
ENVIRONMENT="production"            # production | staging | development
DEBUG=False
API_V1_PREFIX="/api/v1"
ALLOWED_HOSTS="aifabric.retail,app.aifabric.retail"

# --- Auth ------------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`
SECRET_KEY="REPLACE_WITH_64_CHAR_RANDOM_HEX_FROM_OPENSSL_RAND_HEX_32"
JWT_ALGORITHM="HS256"
JWT_ISSUER="aifabric-auth"
JWT_AUDIENCE="aifabric-api"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS="https://aifabric.retail,https://app.aifabric.retail"

# --- AWS / S3 --------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="ai-fabric-secure-storage-prod"
AWS_S3_KMS_KEY_ID=""
AWS_SECRETS_MANAGER_SECRET_NAME="aifabric/prod/secrets"
PRESIGNED_URL_TTL_SECONDS=900

# --- PostgreSQL (TLS 1.3 required) ----------------------------------------
POSTGRES_USER="aifabric_app"
POSTGRES_PASSWORD="REPLACE_FROM_VAULT"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_DB="aifabric_prod"
POSTGRES_SSL_MODE="verify-full"
POSTGRES_SSL_CA_FILE="/etc/aifabric/tls/ca.crt"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ----------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="REPLACE_FROM_VAULT"
REDIS_SSL=True
IDEMPOTENCY_TTL_SECONDS=86400

# --- Stripe (hosted Checkout, PCI SAQ A) ----------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_VERSION="2024-06-20"
STRIPE_PRICE_RENDER_PACK="price_xxx"
STRIPE_PRICE_SAAS_MONTHLY="price_xxx"
STRIPE_PRICE_SAAS_ANNUAL="price_xxx"

# --- JazzCash -------------------------------------------------------------
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGER_KEY=""
JAZZCASH_WEBHOOK_SECRET=""

# --- PayFast --------------------------------------------------------------
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_WEBHOOK_SECRET=""

# --- Webhook source allow-lists (official processor CIDRs) ----------------
JAZZCASH_ALLOWED_IPS="202.163.100.0/24,111.68.100.0/24"
PAYFAST_ALLOWED_IPS="103.228.150.0/24,203.81.200.0/24"
STRIPE_ALLOWED_IPS="3.18.12.63/32,3.130.192.231/32,13.235.14.237/32,54.187.174.169/32,54.187.205.235/32,54.187.216.72/32"

# --- AI engine ------------------------------------------------------------
REPLICATE_API_TOKEN=""
RUNPOD_API_KEY=""
GPU_QUEUE_NAME="gpu_render"
CPU_QUEUE_NAME="cpu_media"
RENDER_BUCKET_CAPACITY=10
RENDER_LEAK_RATE_PER_SEC=0.5
SDXL_MODEL_ID="stabilityai/stable-diffusion-xl-base-1.0"
CONTROLNET_MODEL_ID="diffusers/controlnet-canny-sdxl-1.0"
VAE_MODEL_ID="madebyollin/sdxl-vae-fp16-fix"
RENDER_MAX_STEPS=40

# --- ClamAV ---------------------------------------------------------------
CLAMAV_HOST="clamav"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_FAIL_CLOSED=True

# --- Field-level AES-256-GCM key (base64, 32 bytes) -----------------------
FIELD_ENCRYPTION_KEY=""

METRICS_ENABLED=True
