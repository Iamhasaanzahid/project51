# Application Environment Configuration Example
# Copy to .env for local testing (Do NOT commit .env to version control)

PROJECT_NAME="AI Fabric & Retail SaaS Ecosystem"
ENVIRONMENT="production" # production, staging, development
DEBUG=False
SECRET_KEY="REPLACE_WITH_HIGH_ENTROPY_64_CHAR_SECRET_KEY_FOR_JWT_SIGNING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# AWS Credentials & Secrets Manager Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAEXAMPLESECRETKEYID"
AWS_SECRET_ACCESS_KEY="ExampleSecretAccessKeyForAWSServicesDoNotHardcode"
AWS_S3_BUCKET_NAME="ai-fabric-secure-storage-prod"
AWS_SECRETS_MANAGER_SECRET_NAME="aifabric/prod/secrets"

# PostgreSQL Multi-Tenant Database
POSTGRES_USER="aifabric_db_user"
POSTGRES_PASSWORD="SuperSecureDBPasswordChangeInVault2026!"
POSTGRES_HOST="postgres-db"
POSTGRES_PORT=5432
POSTGRES_DB="aifabric_prod"
POSTGRES_SSL_MODE="verify-full"
POSTGRES_SSL_CA_FILE="/etc/ssl/certs/rds-ca-root.pem"

# Redis Cache & Celery Broker
REDIS_HOST="redis-cache"
REDIS_PORT=6379
REDIS_PASSWORD="SuperSecureRedisPasswordChangeInVault2026!"
REDIS_SSL=True

# Payment Gateway API Keys & Webhook Secrets
STRIPE_SECRET_KEY="sk_live_example_stripe_secret_key_from_vault"
STRIPE_WEBHOOK_SECRET="whsec_example_stripe_webhook_signing_secret"

JAZZCASH_MERCHANT_ID="JC_MERCHANT_PROD_1002"
JAZZCASH_PASSWORD="JC_PASSWORD_PROD"
JAZZCASH_INTEGER_KEY="JC_INTEGER_KEY"
JAZZCASH_WEBHOOK_SECRET="JC_WEBHOOK_HMAC_SECRET"

PAYFAST_MERCHANT_ID="PF_MERCHANT_PROD_5001"
PAYFAST_SECURED_KEY="PF_SECURED_KEY_PROD"
PAYFAST_WEBHOOK_SECRET="PF_WEBHOOK_HMAC_SECRET"

# Allowed Payment Gateway IP Subnets (Comma-separated CIDR)
JAZZCASH_ALLOWED_IPS="202.163.100.0/24,111.68.100.0/24"
PAYFAST_ALLOWED_IPS="103.228.150.0/24,203.81.200.0/24"
STRIPE_ALLOWED_IPS="54.187.174.169/32,54.187.205.235/32,54.187.216.72/32"

# External AI Engine Keys
REPLICATE_API_TOKEN="r8_example_replicate_api_token"
RUNPOD_API_KEY="rpk_example_runpod_api_key"

# Malware Scanning
CLAMAV_HOST="clamav-service"
CLAMAV_PORT=3310
