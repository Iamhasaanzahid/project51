{
  "uid": "aifabric-sec",
  "title": "AI Fabric — Security & Payments",
  "tags": ["aifabric", "security", "payments"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Authentication failures by reason",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (increase(aifabric_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payment events by provider/status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider, status) (increase(aifabric_payment_events_total[5m]))",
          "legendFormat": "{{provider}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Webhook IP blocks (24h)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(aifabric_security_violations_total{kind=\"webhook_ip_blocked\"}[24h]))",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate-limited requests (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(aifabric_render_requests_total{status=\"rate_limited\"}[1h]))", "refId": "A" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uploads rejected (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(aifabric_upload_rejections_total[1h]))", "refId": "A" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Settled volume (24h, minor units)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(aifabric_payment_amount_minor_total[24h]))", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Security violations (Loki)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"api\"} |= \"security_violation\"",
          "refId": "A"
        }
      ]
    }
  ]
}
