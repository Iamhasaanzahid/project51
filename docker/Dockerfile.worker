# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# GPU worker - non-root, read-only rootfs (enforced at runtime), no shell tools.
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements-worker.txt requirements-api.txt ./
RUN pip wheel --wheel-dir /wheels -r requirements-worker.txt

# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch

RUN apt-get update \
    && apt-get install -y --no-install-recommends libmagic1 libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /cache/huggingface /cache/torch /tmp \
    && chown -R app:app /cache /tmp

COPY --from=builder /wheels /wheels
COPY requirements-worker.txt requirements-api.txt ./
RUN pip install --no-index --find-links=/wheels -r requirements-worker.txt \
    && rm -rf /wheels requirements-worker.txt requirements-api.txt

WORKDIR /app
COPY --chown=app:app app ./app

# The model cache is mounted read-write; everything else is read-only at runtime.
USER 10001:10001
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD celery -A app.workers.celery_app inspect ping -d "celery@$(hostname)" || exit 1

CMD ["celery", "-A", "app.workers.celery_app", "worker", "-Q", "gpu_render", "--loglevel=INFO", "--concurrency=1", "--max-tasks-per-child=50"]
