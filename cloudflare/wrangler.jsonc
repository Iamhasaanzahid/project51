{
  // MHZALY AI proxy — free Cloudflare Worker.
  // Deploy from this folder:  npx wrangler deploy
  "name": "mhzaly-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Free Workers AI (FLUX / SDXL) — no API key needed, runs inside Cloudflare.
  "ai": {
    "binding": "AI"
  },
  // Per-IP rate limiting for the public API. Without it, anyone who can
  // spoof an Origin header could spend the shared free quota.
  "ratelimits": [
    {
      "name": "AI_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
