  "info": {
    "contact": {
      "name": "AI Fabric Platform Security",
      "url": "https://github.com/Iamhasaanzahid/project51"
    },
    "description": "Multi-tenant AI fabric rendering and retail payments API.\n\n**Security model**: short-lived JWT access tokens, scope-based RBAC, schema-per-tenant PostgreSQL with row-level security, server-authoritative pricing, Stripe hosted Checkout (PCI SAQ A), HMAC-verified local-gateway webhooks, magic-byte + ClamAV media ingestion, and an atomic Redis leaky-bucket shield in front of GPU work.\n\nInteractive docs are disabled in production (`ENVIRONMENT=production`). Export the schema with `python scripts/export_openapi.py` and publish it to an authenticated developer portal.",
    "license": {
      "name": "Proprietary"
    },
    "title": "AI Fabric & Retail SaaS Ecosystem",
    "version": "2.0.0"
  },
